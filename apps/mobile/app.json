{
  "expo": {
    "name": "Budget-OX",
    "slug": "budget-tracker",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "budgettracker",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgettracker.app",
      "infoPlist": {
        "CFBundleDisplayName": "Budget-OX"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.budgettracker.app",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Budget-OX utilise ta position pour pré-sélectionner ton pays et ta région."
        }
      ],
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Budget-OX enregistre vos reçus dans votre photothèque.",
          "savePhotosPermission": "Budget-OX enregistre vos reçus dans votre photothèque."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Budget-OX utilise ta galerie pour joindre un reçu, un certificat d’authenticité ou une photo de bien.",
          "cameraPermission": "Budget-OX utilise la caméra pour photographier tes reçus et les joindre à une transaction."
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Budget-OX utilise le micro pour te laisser dicter une transaction."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png"
  }
}
