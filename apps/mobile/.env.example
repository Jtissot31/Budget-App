# Budget Tracker Mobile — variables d'environnement

# Empêche Expo / Metro d'ouvrir Edge ou Chrome automatiquement
BROWSER=none

# Gemini Flash (gemini-flash-latest) — chat Fyn, insights, plans, RFA, solutions d'alerte
EXPO_PUBLIC_GEMINI_API_KEY=

# Claude Sonnet 4.5 — chat conseiller financier
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Mock/demo financial seed (accounts, transactions, loans, budgets…).
# Default: ON in Expo Go / Expo web / Metro (__DEV__), OFF in EAS APK (eas.json forces 0).
# Set 0 to force off locally (APK-like empty app). Set 1 to force on in release builds.
# EXPO_PUBLIC_SEED_DEMO=
# EXPO_PUBLIC_USE_MOCK_DATA=

# Copier ce fichier vers `.env` dans ce dossier (apps/mobile/) et renseigner les clés.
# Puis redémarrer Expo avec cache vidé : npm start -- --clear
# Sans clés, l'app fonctionne en mode démo avec résumés locaux.
