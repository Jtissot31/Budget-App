{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug --no-configure-on-demand"
      },
      "env": {
        "EXPO_PUBLIC_SEED_DEMO": "0",
        "EXPO_PUBLIC_USE_MOCK_DATA": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease --no-configure-on-demand"
      },
      "env": {
        "EXPO_PUBLIC_SEED_DEMO": "0",
        "EXPO_PUBLIC_USE_MOCK_DATA": "0"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease --no-configure-on-demand"
      },
      "env": {
        "EXPO_PUBLIC_SEED_DEMO": "0",
        "EXPO_PUBLIC_USE_MOCK_DATA": "0"
      }
    }
  }
}
